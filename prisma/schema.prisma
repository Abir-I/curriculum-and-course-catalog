// Module 2 - Curriculum and Course Catalog
// Prisma models for the 14 Module 2 tables. Triggers, lock-based clash checks and the
// append-only audit rule are in migrations/0002_rules (Prisma cannot express them).
// Cross-module references (users, students) are UUID columns with no relation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicUnit {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId     String?        @map("parent_id") @db.Uuid
  unitType     String         @map("unit_type")
  code         String         @unique
  nameEn       String         @map("name_en")
  nameBn       String?        @map("name_bn")
  termPattern  String?        @map("term_pattern")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent       AcademicUnit?  @relation("UnitTree", fields: [parentId], references: [id])
  children     AcademicUnit[] @relation("UnitTree")
  stages       AcademicStage[]
  curricula    Curriculum[]
  degreePlans  DegreePlan[]
  relations    CourseRelation[]
  policies     AcademicPolicy[]

  @@map("academic_units")
}

model AcademicStage {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId    String         @map("program_id") @db.Uuid
  seqNo        Int            @map("seq_no")
  nameEn       String         @map("name_en")
  nameBn       String?        @map("name_bn")
  nextStageId  String?        @map("next_stage_id") @db.Uuid
  isActive     Boolean        @default(true) @map("is_active")

  program      AcademicUnit   @relation(fields: [programId], references: [id])
  nextStage    AcademicStage? @relation("StageChain", fields: [nextStageId], references: [id])
  previous     AcademicStage[] @relation("StageChain")
  items        CurriculumItem[]

  @@unique([programId, seqNo], map: "uq_stage_order")
  @@map("academic_stages")
}

model AcademicTerm {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termType      String           @map("term_type")
  sessionLabel  String           @map("session_label")
  nameEn        String           @map("name_en")
  nameBn        String?          @map("name_bn")
  startsOn      DateTime?        @map("starts_on") @db.Date
  endsOn        DateTime?        @map("ends_on") @db.Date
  isActive      Boolean          @default(true) @map("is_active")

  offerings     CourseOffering[]
  meetings      SectionMeeting[]

  @@unique([termType, sessionLabel], map: "uq_term_session")
  @@map("academic_terms")
}

model Course {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String           @unique
  titleEn        String           @map("title_en")
  titleBn        String?          @map("title_bn")
  theoryCredit   Decimal          @map("theory_credit") @db.Decimal(4, 2)
  labCredit      Decimal          @map("lab_credit") @db.Decimal(4, 2)
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  offerings      CourseOffering[]
  items          CurriculumItem[]
  rules          PrerequisiteRule[]
  relationsFrom  CourseRelation[] @relation("RelationFrom")
  relationsTo    CourseRelation[] @relation("RelationTo")

  @@index([titleEn], map: "idx_courses_title")
  @@map("courses")
}

model Curriculum {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId       String           @map("program_id") @db.Uuid
  degreePlanId    String?          @map("degree_plan_id") @db.Uuid
  versionCode     String?          @unique @map("version_code")
  versionNo       Int              @map("version_no")
  cohortStartYear Int              @map("cohort_start_year")
  cohortEndYear   Int?             @map("cohort_end_year")
  status          String           @default("DRAFT")
  parentVersionId String?          @map("parent_version_id") @db.Uuid
  preparedBy      String           @map("prepared_by") @db.Uuid
  approvedBy      String?          @map("approved_by") @db.Uuid
  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  program         AcademicUnit     @relation(fields: [programId], references: [id])
  degreePlan      DegreePlan?      @relation(fields: [degreePlanId], references: [id])
  parentVersion   Curriculum?      @relation("VersionTree", fields: [parentVersionId], references: [id])
  childVersions   Curriculum[]     @relation("VersionTree")
  items           CurriculumItem[]
  offerings       CourseOffering[]

  @@unique([programId, versionNo], map: "uq_curriculum_version")
  @@map("curricula")
}

model CurriculumItem {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumId        String            @map("curriculum_id") @db.Uuid
  parentItemId        String?           @map("parent_item_id") @db.Uuid
  itemType            String            @map("item_type")
  groupType           String?           @map("group_type")
  courseId            String?           @map("course_id") @db.Uuid
  stageId             String?           @map("stage_id") @db.Uuid
  copiedTheoryCredit  Decimal?          @map("copied_theory_credit") @db.Decimal(4, 2)
  copiedLabCredit     Decimal?          @map("copied_lab_credit") @db.Decimal(4, 2)
  minCredits          Decimal?          @map("min_credits") @db.Decimal(6, 2)
  minCourses          Int?              @map("min_courses")
  conditionJson       Json?             @map("condition_json") @db.JsonB
  poolRule            Json?             @map("pool_rule") @db.JsonB
  sortOrder           Int               @default(0) @map("sort_order")

  curriculum          Curriculum        @relation(fields: [curriculumId], references: [id])
  parentItem          CurriculumItem?   @relation("ItemTree", fields: [parentItemId], references: [id])
  children            CurriculumItem[]  @relation("ItemTree")
  course              Course?           @relation(fields: [courseId], references: [id])
  stage               AcademicStage?    @relation(fields: [stageId], references: [id])
  rules               PrerequisiteRule[]

  @@map("curriculum_items")
}

model PrerequisiteRule {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumItemId String           @map("curriculum_item_id") @db.Uuid
  ruleKind         String           @map("rule_kind")
  nodeType         String           @map("node_type")
  parentNodeId     String?          @map("parent_node_id") @db.Uuid
  courseId         String?          @map("course_id") @db.Uuid
  minGrade         String?          @map("min_grade")
  isWaivable       Boolean          @default(false) @map("is_waivable")
  sortOrder        Int              @default(0) @map("sort_order")

  item             CurriculumItem   @relation(fields: [curriculumItemId], references: [id])
  parentNode       PrerequisiteRule? @relation("RuleTree", fields: [parentNodeId], references: [id])
  childNodes       PrerequisiteRule[] @relation("RuleTree")
  course           Course?          @relation(fields: [courseId], references: [id])

  @@map("prerequisite_rules")
}

model CourseRelation {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String        @map("course_id") @db.Uuid
  relatedCourseId String        @map("related_course_id") @db.Uuid
  relationType    String        @map("relation_type")
  scopeUnitId     String?       @map("scope_unit_id") @db.Uuid
  approvedBy      String        @map("approved_by") @db.Uuid
  effectiveFrom   DateTime      @map("effective_from") @db.Date
  effectiveTo     DateTime?     @map("effective_to") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  course          Course        @relation("RelationFrom", fields: [courseId], references: [id])
  relatedCourse   Course        @relation("RelationTo", fields: [relatedCourseId], references: [id])
  scopeUnit       AcademicUnit? @relation(fields: [scopeUnitId], references: [id])

  @@map("course_relations")
}

model AcademicPolicy {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyKey     String        @map("policy_key")
  scopeUnitId   String?       @map("scope_unit_id") @db.Uuid
  value         Json          @db.JsonB
  effectiveFrom DateTime      @map("effective_from") @db.Date
  effectiveTo   DateTime?     @map("effective_to") @db.Date
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  scopeUnit     AcademicUnit? @relation(fields: [scopeUnitId], references: [id])

  @@unique([policyKey, scopeUnitId, effectiveFrom], map: "uq_policy_version")
  @@map("academic_policies")
}

model Room {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String           @unique
  building  String?
  campus    String?
  roomType  String           @map("room_type")
  capacity  Int
  isActive  Boolean          @default(true) @map("is_active")

  meetings  SectionMeeting[]

  @@map("rooms")
}

model CourseOffering {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String           @map("course_id") @db.Uuid
  termId        String           @map("term_id") @db.Uuid
  curriculumId  String?          @map("curriculum_id") @db.Uuid
  status        String           @default("DRAFT")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  course        Course           @relation(fields: [courseId], references: [id])
  term          AcademicTerm     @relation(fields: [termId], references: [id])
  curriculum    Curriculum?      @relation(fields: [curriculumId], references: [id])
  sections      CourseSection[]

  @@unique([courseId, termId], map: "uq_offering_course_term")
  @@map("course_offerings")
}

model CourseSection {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId            String           @map("offering_id") @db.Uuid
  sectionCode           String           @map("section_code")
  sectionType           String           @map("section_type")
  linkedTheorySectionId String?          @map("linked_theory_section_id") @db.Uuid
  instructorUserId      String?          @map("instructor_user_id") @db.Uuid
  capacity              Int
  isActive              Boolean          @default(true) @map("is_active")

  offering              CourseOffering   @relation(fields: [offeringId], references: [id])
  linkedTheory          CourseSection?   @relation("LabLink", fields: [linkedTheorySectionId], references: [id])
  labs                  CourseSection[]  @relation("LabLink")
  meetings              SectionMeeting[]

  @@unique([offeringId, sectionCode], map: "uq_section_code")
  @@map("course_sections")
}

model SectionMeeting {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId   String        @map("section_id") @db.Uuid
  roomId      String        @map("room_id") @db.Uuid
  termId      String        @map("term_id") @db.Uuid
  dayOfWeek   Int           @map("day_of_week") @db.SmallInt
  startMinute Int           @map("start_minute") @db.SmallInt
  endMinute   Int           @map("end_minute") @db.SmallInt

  section     CourseSection @relation(fields: [sectionId], references: [id])
  room        Room          @relation(fields: [roomId], references: [id])
  term        AcademicTerm  @relation(fields: [termId], references: [id])

  @@index([roomId, termId, dayOfWeek], map: "idx_meetings_room_day")
  @@map("section_meetings")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  requestId   String   @map("request_id")
  details     Json     @default("{}") @db.JsonB
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([entityType, entityId, occurredAt], map: "idx_audit_entity")
  @@index([actorId, occurredAt], map: "idx_audit_actor")
  @@map("audit_logs")
}

model DegreePlan {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planCode  String       @unique @map("plan_code")
  programId String       @map("program_id") @db.Uuid
  nameEn    String       @map("name_en")
  nameBn    String?      @map("name_bn")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  program   AcademicUnit @relation(fields: [programId], references: [id])
  versions  Curriculum[]

  @@map("degree_plans")
}
